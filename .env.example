# Silva Signage Network — environment template.
# Copy to .env and fill in. Never commit real secrets.

NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://silva:silva_dev@localhost:5432/silva_signage
TEST_DATABASE_URL=postgres://silva:silva_dev@localhost:5432/silva_signage_test

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated origins allowed to make state-changing requests (CSRF origin check)
WEB_ORIGINS=http://localhost:5173,http://localhost:5174
# 32+ random bytes, base64. Used to sign media delivery URLs and pepper pairing codes.
APP_SECRET=replace-with-output-of-openssl-rand-base64-48
# Dev only: allow Silva super admins to use the admin API before enrolling MFA.
# Must be false (or unset) in production.
ALLOW_ADMIN_WITHOUT_MFA=false

# Object storage (S3-compatible). STORAGE_DRIVER=local stores files under ./storage for development.
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=silva-signage-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Stripe (Phase 5). Leave blank until a Stripe account is configured; billing endpoints report "not configured".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Media limits (conservative defaults)
MEDIA_MAX_IMAGE_BYTES=10485760
MEDIA_MAX_VIDEO_BYTES=104857600
MEDIA_MAX_VIDEO_SECONDS=60
