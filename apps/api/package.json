{
  "name": "@silva/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "worker": "node --env-file-if-exists=../../.env --import tsx src/worker.ts",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "demo": "tsx --env-file-if-exists=../../.env src/scripts/demo.ts",
    "test": "tsx --env-file-if-exists=../../.env --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@silva/shared": "workspace:*",
    "fastify": "^5.3.0",
    "fastify-type-provider-zod": "^7.0.0",
    "postgres": "^3.4.5",
    "sharp": "^0.34.0",
    "stripe": "^18.0.0",
    "zod": "^4.0.0"
  }
}
